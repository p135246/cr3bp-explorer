#!/bin/sh

message_file="$1"
first_line=$(sed -n '1p' "$message_file")

case "$first_line" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *)
    exit 0
    ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|chore|ci)(\([[:alnum:]_.-]+\))?!?: [^ ].+$'

if printf '%s\n' "$first_line" | grep -Eq "$pattern"; then
  exit 0
fi

cat >&2 <<'EOF'
Commit message must use conventional commit format:

  type(scope): description

Valid types:
  feat, fix, docs, style, refactor, perf, test, chore, ci

Examples:
  docs(readme): fix typo in installation section
  chore(repo): update file permissions
  fix(cr3bp): correct libration point label
EOF

exit 1